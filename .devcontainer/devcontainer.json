{
  "name": "EVRAK (Flutter)",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "features": {
    "ghcr.io/devcontainers-extra/features/flutter-sdk:2": {
      "version": "3.47.2",
      "channel": "stable"
    }
  },
  "postCreateCommand": "flutter pub get",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/usr/local/flutter"
      }
    }
  },
  "forwardPorts": [],
  "remoteUser": "vscode"
}
