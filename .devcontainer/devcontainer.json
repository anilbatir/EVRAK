{
  "name": "EVRAK (Flutter)",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "postCreateCommand": "bash .devcontainer/setup-flutter.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "~/flutter"
      }
    }
  },
  "remoteUser": "vscode"
}
